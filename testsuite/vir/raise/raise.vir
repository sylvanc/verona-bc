lib
  @set_exit_code = "set_exit_code"(i32): none

// Test non-local return via raise across static calls.
//
// enclosing captures its i32 frame as the raise target and passes it through
// middle to inner. Raising 42 skips inner, middle, and enclosing, so main
// receives 42 as the result of its ordinary call to enclosing.

func @inner($value: i32, $target: u64): i32
  $prev = setraise $target
  raise $value i32

func @middle($target: u64): i32
  $value = const i32 42
  $result = call @inner($value, $target)
  $bad = const i32 99
  ret $bad

func @enclosing(): i32
  $target = getraise
  $result = call @middle($target)
  $bad = const i32 99
  ret $bad

func @main(): none
  $result = call @enclosing()
  $_ = ffi @set_exit_code($result)
  $_none = const none
  ret $_none
