// Coverage:
// - Lowers assignments to one mutable local from alternative predecessor
//   blocks and reads the joined value in their shared successor.
//
// Native VRT coverage:
// - Starts the generated program and records the joined result as its status.
//
// Non-goals:
// - Does not exercise nested joins, loops, or object-valued locals.

lib
  @set_exit_code = "set_exit_code"(i32): none

func @main(): none var $res : i32
  $true = const bool true
  cond $true ^check_false ^fail
^check_false
  $res = const i32 1
  jump ^exit
^fail
  $res = const i32 2
  jump ^exit
^exit
  $_success = ffi @set_exit_code($res)
  $_success_none = const none
  ret $_success_none
