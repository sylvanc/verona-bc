// Coverage:
// - Lowers scalar Copy, Move, and Drop statements while preserving the copied
//   source and consuming the mutable move source.
//
// Native VRT coverage:
// - Starts the generated program and records both scalar values as statuses.
//
// Non-goals:
// - Does not exercise object ownership, region transfer, or finalization.

lib
  @set_exit_code = "set_exit_code"(i32): none

func @main(): none var $copy: i32
  $original = const i32 0
  $copy = copy $original
  $_copy_call = ffi @set_exit_code($original)
  drop $original
  $moved = move $copy
  $_move_call = ffi @set_exit_code($moved)
  $_none = const none
  ret $_none
