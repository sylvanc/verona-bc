// Coverage:
// - Merges multiple process-local Lib fragments with the same empty path and
//   resolves symbols from both fragments through the combined library.
//
// Native VRT coverage:
// - Starts the generated program and records its status through set_exit_code.
// - malloc and free resolve to the host C library rather than VRT.
//
// Non-goals:
// - Does not exercise separate library paths, library initialization, or
//   generated object metadata.

lib
  @set_exit_code = "set_exit_code"(i32): none

lib
  @malloc = "malloc"(usize): ptr
  @free = "free"(ptr): none

func @main(): none
  $allocation_size = const usize 1
  $allocation = ffi @malloc($allocation_size)
  $_free = ffi @free($allocation)
  $success = const i32 0
  $_exit = ffi @set_exit_code($success)
  $_none = const none
  ret $_none
