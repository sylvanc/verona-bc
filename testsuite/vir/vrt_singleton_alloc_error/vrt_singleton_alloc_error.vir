// See README.md for VRT singleton allocation error coverage.

class @Singleton

class @Box
  @value: i32

func @consume($_box: @Box): none
  $_none = const none
  ret $_none

func @main(): none
  $locator = new @Singleton()
  $value = const i32 1
  $bad = heap $locator @Box($value)
  $_consume = call @consume($bad)
  $_none = const none
  ret $_none
