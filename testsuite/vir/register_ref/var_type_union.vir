lib
  @set_exit_code = "set_exit_code"(i32): none

// A union-typed var accepts values of either member type via Copy.
// `&x` for a var x of type T produces ref[T]; the ref's payload type is
// the var's declared static type (so future writes of any T are valid).
// Reads through the ref therefore yield T (statically); a typetest is
// required to narrow back to a concrete member.

type @intorbool = i32 | bool

func @main(): none var $x: @intorbool, $y: @intorbool
  // Store an i32 into the union var.
  $val1 = const i32 42
  $x = copy $val1
  // Store a bool into the second union var.
  $val2 = const bool true
  $y = copy $val2
  // Store through ref with matching types.
  $rx = ref $x
  $val3 = const i32 99
  // store returns the previous value, statically of type @intorbool.
  $prev = store $rx $val3
  // Narrow $prev to i32 before comparing.
  $prev_is_i32 = typetest $prev i32
  cond $prev_is_i32 ^check_prev ^fail
^check_prev
  $prev_i32 = convert i32 $prev
  $exp = const i32 42
  $ok1 = eq $prev_i32 $exp
  cond $ok1 ^check_cur ^fail
^check_cur
  // load returns @intorbool; narrow to i32.
  $cur = load $rx
  $cur_is_i32 = typetest $cur i32
  cond $cur_is_i32 ^check_cur_val ^fail
^check_cur_val
  $cur_i32 = convert i32 $cur
  $ok2 = eq $cur_i32 $val3
  cond $ok2 ^ok ^fail
^ok
  $ret = const i32 0
  $_ = ffi @set_exit_code($ret)
  $_none = const none
  ret $_none
^fail
  $ret = const i32 1
  $_ = ffi @set_exit_code($ret)
  $_none = const none
  ret $_none
