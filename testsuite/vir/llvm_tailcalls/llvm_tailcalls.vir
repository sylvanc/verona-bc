// Coverage:
// - Lowers a direct tail call with an i32 argument from @main to @finish.
//
// Native VRT coverage:
// - Runs the generated tail-call path through the VRT program entry point.
//
// Non-goals:
// - Does not exercise dynamic tail calls, non-local returns, or object values.

lib
  @set_exit_code = "set_exit_code"(i32): none

func @finish($code: i32): none
  $_result = ffi @set_exit_code($code)
  $_none = const none
  ret $_none

func @main(): none
  $success = const i32 0
  tailcall @finish($success)
